{
 "_note": "Tunable. See SCORING.md. Patterns are lowercase regex. Order: noise (dropped), question (ask), wall, decision, ask.",
 "noise": [
  "^please continue\\b",
  "^continue$",
  "^\\d+>",
  "\\berror [a-z]*\\d+",
  "\\btraceback\\b",
  "^\\s*[|#]"
 ],
 "question": [
  "\\?$",
  "^(why|what|how|which|where|who|when|is|are|does|did|do you|tell me)\\b"
 ],
 "wall": [
  "\\bnever\\b",
  "\\balways\\b",
  "\\bmust\\b",
  "\\bwall\\b",
  "\\bevery time\\b",
  "\\bonce again\\b",
  "\\bwhy (did )?you (not|still|didn't)\\b",
  "\\bi told you\\b",
  "\\bno matter\\b",
  "\\bdo not ever\\b",
  "\\bdon't ever\\b",
  "\\b(follow|keep|check) (the|my|every|each) rules?\\b",
  "^report to me first\\b"
 ],
 "decision": [
  "^(now |then |also |and |ok |please |so )?(use|go with|choose|pick|switch to|keep|drop|hold|stop|skip|remove|move)\\b",
  "\\bi choose\\b",
  "^(option )?[0-9a-d]\\b$",
  "^(yes|no|go|agree)\\b$",
  "\\binstead\\b",
  "\\bdon't\\b",
  "\\bdo not\\b",
  "\\bnot now\\b",
  "\\bfirst\\b"
 ],
 "ask": [
  "^(now |then |also |and |ok |please |so )?(add|make|run|show|fix|build|render|check|write|do|tell|explain|create|update|rename|note|send|list|find|draft|test)\\b",
  "\\bi (want|need)\\b",
  "\\bplease\\b",
  "\\bcan you\\b"
 ],
 "stop_words": [
  "the",
  "a",
  "an",
  "and",
  "or",
  "to",
  "of",
  "in",
  "on",
  "for",
  "with",
  "it",
  "is",
  "be",
  "this",
  "that",
  "use",
  "keep",
  "make",
  "add",
  "not",
  "no",
  "do",
  "don't",
  "i",
  "we",
  "you",
  "so",
  "all",
  "as",
  "at",
  "by",
  "from",
  "then",
  "now",
  "must",
  "never",
  "always",
  "only"
 ],
 "repeat_overlap": 0.6,
 "supersede_overlap": 0.5,
 "max_words": 25,
 "walls_every_n_prompts": 5,
 "restore_max_tokens": 600,
 "state_max_lines": 8,
 "quote_min_words": 6,
 "said_max_chars": 200000,
 "recall_words": 12,
 "tail_ref": "\\b(it|them|that|this|those)\\b"
}